# Copy to .env and adjust. All values are optional — the server falls back to the
# defaults shown here.

# Server bind address
PORT=3000
HOST=127.0.0.1

# Docker daemon endpoint (defaults to tcp://127.0.0.1:2375)
# DOCKER_HOST=tcp://127.0.0.1:2375

# Set to 0 to stop holding the WSL distro open while the server runs
# DOCKER_WSL_KEEPALIVE=1

# How long a running build may go silent before the stale sweep fails it (milliseconds)
# BUILD_STALE_TIMEOUT_MS=600000
